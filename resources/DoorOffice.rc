// Door Office v1.0 — Windows resource script
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Embeds resources/DoorOffice.ico as the executable icon shown by
// Explorer / the taskbar. The icon file lives next to this script.

#include <windows.h>

IDI_MAINICON ICON "DoorOffice.ico"

// Version metadata (optional but nice for file properties).
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Door Office contributors"
            VALUE "FileDescription",  "Door Office"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "DoorOffice"
            VALUE "OriginalFilename", "DoorOffice.exe"
            VALUE "ProductName",      "Door Office"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
